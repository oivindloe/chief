FROM python:3.15-slim@sha256:63bb298d2b7b88f176f51b5189f54ce6535c997682ea70885d2132f5d473a8a5

ENV LANG=C.UTF-8
ENV TZ=UTC
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DEBUG=false
ENV DJANGO_ENV=production

# Refresh the CA bundle used for outbound HTTPS.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system app \
    && useradd --system --gid app --home-dir /app app

COPY --from=ghcr.io/astral-sh/uv:0.13.9@sha256:d3b601f0c7b118bc1753febf7c41cc80981df678445e0254284eecf84db79a7d /uv /usr/local/bin/uv

# Install only the backend's standalone locked runtime environment.
WORKDIR /app
COPY ./backend/pyproject.toml /app/pyproject.toml
COPY ./backend/uv.lock /app/uv.lock
RUN uv export --frozen --package chief-backend-env --output-file requirements.lock.txt \
    && uv pip install --system --require-hashes -r requirements.lock.txt --no-cache \
    && rm -f requirements.lock.txt /usr/local/bin/uv

COPY --chown=app:app ./olib /olib
COPY --chown=app:app ./backend /app

USER app

EXPOSE 8000

CMD ["./entrypoint.sh"]
